# Supabase 프로젝트 설정 (https://supabase.com/dashboard 에서 발급)
# 로컬 개발은 `.env.local`(npm run dev) 또는 `.env`(docker compose up)에 복사해 사용.
#  - Supabase CLI 로컬 스택(`npx supabase start`) 사용 시:
#      npm run dev      → NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
#      docker compose   → NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
#    anon key 는 `npx supabase status` 출력값.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 넥슨 OpenAPI 키는 각 사용자가 앱 내 설정에서 직접 등록합니다(env 아님).
# (https://openapi.nexon.com 에서 발급)
