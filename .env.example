# Supabase 프로젝트 설정 (https://supabase.com/dashboard 에서 발급)
# 로컬 개발은 `.env.local`(npm run dev) 또는 `.env`(docker compose up)에 복사해 사용.
#  - Supabase CLI 로컬 스택(`npx supabase start`) 사용 시:
#      npm run dev      → NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
#      docker compose   → NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
#    anon key 는 `npx supabase status` 출력값.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (선택) 메일 링크(비밀번호 재설정)에 넣을 이 앱의 공개 주소. 비워두면 요청의 origin 헤더를
# 쓰므로 로컬·Vercel 프로덕션·프리뷰 모두 자동으로 맞는다. 커스텀 도메인을 쓰거나 프록시
# 뒤에 있어 헤더의 호스트가 실제 공개 주소와 다를 때만 명시한다. 끝에 슬래시 없이.
#   예) NEXT_PUBLIC_SITE_URL=https://mapletool.vercel.app
# 주의: 여기에 넣은 주소는 Supabase 의 Redirect URL 허용목록에도 등록돼 있어야 한다
#       (없으면 링크가 조용히 Site URL 로 폴백한다 — DEPLOY.md 2-2 참고).
# NEXT_PUBLIC_SITE_URL=

# 넥슨 OpenAPI 키는 각 사용자가 앱 내 설정에서 직접 등록합니다(env 아님).
# (https://openapi.nexon.com 에서 발급)
